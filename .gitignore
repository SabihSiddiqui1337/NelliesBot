# --- Secrets / local config -------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
secrets.json

# --- Editors / OS -----------------------------------------------------------
.vscode/
.idea/
*.swp
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# --- Local data ---
# SQLite price history. Machine-local and regenerable; keeping it out of git
# avoids a large binary diff on every scan. It does NOT transfer between
# machines — each clone rebuilds its own history.
data/
*.db
*.db-wal
*.db-shm

# --- Logs / temp ------------------------------------------------------------
logs/
*.log
tmp/
.cache/

# --- Node -------------------------------------------------------------------
node_modules/
dist/
build/
npm-debug.log*
yarn-error.log*

# --- Python -----------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
*.egg-info/

# --- .NET -------------------------------------------------------------------
bin/
obj/
*.user
