# Copy to .env and fill in. .env is git-ignored — never commit real tokens.

# Discord incoming webhook for the alert channel.
# Server Settings -> Integrations -> Webhooks -> New Webhook -> Copy URL
DISCORD_WEBHOOK_URL=

# Nellis shopping location. 5 = Houston, TX (SW Houston + Katy).
NELLIS_SHOPPING_LOCATION_ID=5

# Demand/comps provider key, once chosen.
KEEPA_API_KEY=

LOG_LEVEL=info
